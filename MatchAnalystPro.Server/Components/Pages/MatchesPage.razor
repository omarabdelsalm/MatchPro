@page "/matches"
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="content-wrapper">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <div>
            <h1 class="page-title" style="margin:0;">📋 إدارة المباريات والفرق</h1>
            <p style="margin:4px 0 0 0; color:var(--text-muted); font-size:13px;">إضافة وتعديل بيانات المباريات، مسارات ملفات الفيديو، والتشكيلات</p>
        </div>
        <button class="primary" @onclick="ToggleNewMatchForm">
            @(_showNewMatch ? "✖ إلغاء" : "➕ إضافة مباراة جديدة")
        </button>
    </div>

    @if (_showNewMatch)
    {
        <div class="card" style="border-color:#58a6ff;">
            <h2 class="card-title">إضافة مباراة جديدة</h2>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                <div class="field-group">
                    <label>الفريق المضيف</label>
                    <select @bind="_newHomeTeamId">
                        <option value="0">-- اختر --</option>
                        @foreach (var t in _teams)
                        {
                            <option value="@t.Id">@t.NameAr (@t.Name)</option>
                        }
                    </select>
                </div>
                <div class="field-group">
                    <label>الفريق الضيف</label>
                    <select @bind="_newAwayTeamId">
                        <option value="0">-- اختر --</option>
                        @foreach (var t in _teams)
                        {
                            <option value="@t.Id">@t.NameAr (@t.Name)</option>
                        }
                    </select>
                </div>
                <div class="field-group">
                    <label>البطولة</label>
                    <input type="text" @bind="_newCompetition" placeholder="مثال: الدوري المصري الممتاز" />
                </div>
                <div class="field-group">
                    <label>الملعب</label>
                    <input type="text" @bind="_newVenue" placeholder="مثال: ستاد القاهرة الدولي" />
                </div>
                <div class="field-group">
                    <label>تاريخ المباراة</label>
                    <input type="date" @bind="_newDate" />
                </div>
                <div class="field-group">
                    <label>معدل إطارات الفيديو (FPS)</label>
                    <input type="number" @bind="_newFps" />
                </div>
                <div class="field-group" style="grid-column:1 / 3;">
                    <label>مسار ملف الفيديو المحلي (MP4)</label>
                    <input type="text" @bind="_newVideoPath" placeholder="C:\Videos\AlAhly_vs_Zamalek.mp4" />
                </div>
            </div>
            <div style="margin-top:14px; display:flex; gap:8px;">
                <button class="success" @onclick="CreateMatch">حفظ المباراة</button>
                <button @onclick="() => _showNewMatch = false">إلغاء</button>
            </div>
        </div>
    }

    <!-- جدول المباريات -->
    <div class="card">
        <h2 class="card-title">قائمة المباريات المسجلة (@_matches.Count)</h2>
        <div class="table-responsive">
            <table class="pro-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>المباراة</th>
                        <th>البطولة</th>
                        <th>التاريخ</th>
                        <th>ملف الفيديو</th>
                        <th>الأحداث</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in _matches)
                    {
                        <tr>
                            <td>@m.Id</td>
                            <td style="font-weight:700;">
                                <span style="color:#58a6ff;">@m.HomeTeam?.NameAr</span> ضد <span style="color:#f85149;">@m.AwayTeam?.NameAr</span>
                            </td>
                            <td>@m.Competition</td>
                            <td>@m.Date.ToString("yyyy-MM-dd")</td>
                            <td>
                                <div style="display:flex; flex-direction:column; gap:4px; align-items:flex-start;">
                                    @if (!string.IsNullOrEmpty(m.VideoPath) && File.Exists(m.VideoPath))
                                    {
                                        <span class="badge badge-success">متصل: @Path.GetFileName(m.VideoPath)</span>
                                    }
                                    else if (!string.IsNullOrEmpty(m.VideoPath))
                                    {
                                        <span class="badge badge-danger">غير موجود: @Path.GetFileName(m.VideoPath)</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">بدون فيديو</span>
                                    }
                                    <button type="button" class="btn-sm" style="font-size:10px; padding:1px 6px;" 
                                            @onclick="() => ToggleVideoPanel(m.Id)">
                                        📹 @(_activeMatchVideoId == m.Id ? "إغلاق الإدارة" : "ربط / رفع فيديو")
                                    </button>
                                </div>
                            </td>
                            <td>@(m.Events?.Count ?? 0)</td>
                            <td>
                                <div style="display:flex; gap:6px; align-items:center;">
                                    <a href="/tagger/@m.Id" class="badge badge-info" style="text-decoration:none;">🎬 فتح في المصنف</a>
                                    <button class="danger" style="padding:2px 8px; font-size:11px;" @onclick="() => DeleteMatch(m)">حذف</button>
                                </div>
                            </td>
                        </tr>
                        @if (_activeMatchVideoId == m.Id)
                        {
                            <tr style="background:#0d1117;">
                                <td colspan="7" style="padding:10px;">
                                    <VideoSourcePanel MatchId="@m.Id" 
                                                      CurrentVideoPath="@(m.VideoPath ?? "")" 
                                                      OnVideoUpdated="LoadDataAsync" 
                                                      OnClose="() => _activeMatchVideoId = null" />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<Match> _matches = new();
    private List<Team> _teams = new();

    private bool _showNewMatch = false;
    private int _newHomeTeamId;
    private int _newAwayTeamId;
    private string _newCompetition = "الدوري المصري الممتاز";
    private string _newVenue = "ستاد القاهرة";
    private DateTime _newDate = DateTime.Today;
    private int _newFps = 25;
    private string _newVideoPath = "";
    private int? _activeMatchVideoId = null;

    private void ToggleVideoPanel(int matchId)
    {
        if (_activeMatchVideoId == matchId)
            _activeMatchVideoId = null;
        else
            _activeMatchVideoId = matchId;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _teams = await Db.Teams.OrderBy(t => t.NameAr).ToListAsync();
        _matches = await Db.Matches
            .Include(m => m.HomeTeam)
            .Include(m => m.AwayTeam)
            .Include(m => m.Events)
            .OrderByDescending(m => m.Date)
            .ToListAsync();

        if (_teams.Count >= 2 && _newHomeTeamId == 0)
        {
            _newHomeTeamId = _teams[0].Id;
            _newAwayTeamId = _teams[1].Id;
        }
    }

    private void ToggleNewMatchForm()
    {
        _showNewMatch = !_showNewMatch;
    }

    private async Task CreateMatch()
    {
        if (_newHomeTeamId == 0 || _newAwayTeamId == 0)
        {
            await JS.InvokeVoidAsync("alert", "يرجى تحديد الفريقين");
            return;
        }

        var match = new Match
        {
            HomeTeamId = _newHomeTeamId,
            AwayTeamId = _newAwayTeamId,
            Competition = _newCompetition,
            Venue = _newVenue,
            Date = _newDate,
            VideoFps = _newFps > 0 ? _newFps : 25,
            VideoPath = _newVideoPath.Trim(),
            Status = "Tagging"
        };

        Db.Matches.Add(match);
        await Db.SaveChangesAsync();

        _showNewMatch = false;
        await LoadDataAsync();
    }

    private async Task DeleteMatch(Match m)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"هل تريد حذف مباراة {m.HomeTeam?.NameAr} ضد {m.AwayTeam?.NameAr}؟")) return;

        var events = Db.Events.Where(e => e.MatchId == m.Id);
        Db.Events.RemoveRange(events);
        var possessions = Db.Possessions.Where(p => p.MatchId == m.Id);
        Db.Possessions.RemoveRange(possessions);
        var calibs = Db.PitchCalibrations.Where(c => c.MatchId == m.Id);
        Db.PitchCalibrations.RemoveRange(calibs);
        Db.Matches.Remove(m);
        await Db.SaveChangesAsync();

        await LoadDataAsync();
    }
}
