            }

            if (InitialEventId.HasValue)
            {
                var targetEv = _events.FirstOrDefault(e => e.Id == InitialEventId.Value);
                if (targetEv != null)
                {
                    await StartEditEvent(targetEv);
                }
            }
            else if (InitialFrame.HasValue && InitialFrame.Value > 0)
            {
