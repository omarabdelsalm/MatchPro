    private async Task OnVideoPointClicked((double VideoX, double VideoY, double XPct, double YPct, long Frame) pt)
    {
        _currentFrame = pt.Frame;
        _currentTimeMs = (long)(pt.Frame * 1000.0 / (Match?.VideoFps ?? 25));
        _isVideoPlaying = false;

        double pitchX = pt.XPct;
        double pitchY = pt.YPct;

        if (_calibration != null && _homography != null)
        {
            var meters = _coordService.VideoToPitch(pt.VideoX, pt.VideoY, _homography);
            var norm = _coordService.Normalize(meters.X, meters.Y, _calibration.PitchLengthM, _calibration.PitchWidthM);
            pitchX = Math.Round(norm.X, 1);
            pitchY = Math.Round(norm.Y, 1);
        }
        else
        {
            pitchX = Math.Round(pt.XPct, 1);
            pitchY = Math.Round(pt.YPct, 1);
        }

        var cat = EventTaxonomy.GetCategory(_selectedCategory);
        var sub = cat?.SubTypes.FirstOrDefault(s => s.Key == _selectedSubType);
        bool requiresEnd = sub?.RequiresEndPoint ?? (_selectedCategory is "pass" or "carry" or "shot");

        if (_coordMode == 0 || !requiresEnd)
        {
            _currentX = pitchX;
            _currentY = pitchY;
            _videoMarkerXPct = pt.XPct;
            _videoMarkerYPct = pt.YPct;

            if (!requiresEnd)
            {
                _currentEndX = null;
                _currentEndY = null;
                _videoMarkerEndXPct = null;
                _videoMarkerEndYPct = null;
                _coordMode = 0;
            }
            else
            {
                _coordMode = 1;
            }
        }
        else
        {
            _currentEndX = pitchX;
            _currentEndY = pitchY;
            _videoMarkerEndXPct = pt.XPct;
            _videoMarkerEndYPct = pt.YPct;
            _coordMode = 0;
        }

        if (_player != null)
        {
            await _player.SetVideoMarker(
                _videoMarkerXPct,
                _videoMarkerYPct,
                _videoMarkerEndXPct,
                _videoMarkerEndYPct,
                GetCategoryColor(_selectedCategory),
                GetSubTypeName(_selectedCategory, _selectedSubType));
        }

        StateHasChanged();
    }

    private async Task StepFrame(long delta)
    {
        _isVideoPlaying = false;
        var fps = Match?.VideoFps ?? 25;

        if (_multiPlayer != null)
        {
            var target = Math.Max(0, _currentFrame + delta);
            await _multiPlayer.SeekAll(target);
            _currentFrame = target;
        }
        else if (_player != null && !_liveTimerRunning)
        {
            // تحريك عنصر الفيديو الفعلي مباشرة وإرجاع رقم الإطار الجديد
            var newFrame = await _player.StepFramesDirect(delta);
            if (newFrame > 0 || delta < 0)
            {
                _currentFrame = newFrame;
            }
            else
            {
                _currentFrame = Math.Max(0, _currentFrame + delta);
                await _player.SeekToFrame(_currentFrame);
            }
        }
        else
        {
            _currentFrame = Math.Max(0, _currentFrame + delta);
        }

        _currentTimeMs = (long)(_currentFrame * 1000.0 / fps);
        StateHasChanged();
    }

