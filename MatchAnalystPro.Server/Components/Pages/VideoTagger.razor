                _currentTimeMs = (long)(_currentFrame * 1000.0 / (Match?.VideoFps ?? 25));
                if (_player != null)
                {
                    await _player.SeekToFrame(_currentFrame);
                }
                StateHasChanged();
            }
        }
    }

