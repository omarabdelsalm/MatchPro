    private async Task SetClipStartAsync()
    {
        var fps = Match?.VideoFps ?? 25;
        if (_player != null && !_liveTimerRunning)
        {
            var liveFrame = await _player.GetCurrentFrame();
            if (liveFrame > 0) _currentFrame = liveFrame;
        }
        _currentTimeMs = (long)(_currentFrame * 1000.0 / fps);
        _clipStartFrame = _currentFrame;
        if (_clipEndFrame <= _clipStartFrame)
        {
            _clipEndFrame = _clipStartFrame + 5 * fps;
        }
        StateHasChanged();
    }

    private async Task SetClipEndAsync()
    {
        var fps = Match?.VideoFps ?? 25;
        if (_player != null && !_liveTimerRunning)
        {
            var liveFrame = await _player.GetCurrentFrame();
            if (liveFrame > 0) _currentFrame = liveFrame;
        }
        _currentTimeMs = (long)(_currentFrame * 1000.0 / fps);
        _clipEndFrame = _currentFrame;
        if (_clipEndFrame <= _clipStartFrame)
        {
            _clipStartFrame = Math.Max(0, _clipEndFrame - 5 * fps);
        }
        StateHasChanged();
    }

    private async Task PlayClip()
    {
        var fps = Match?.VideoFps ?? 25;
        if (_player != null && !_liveTimerRunning)
        {
            var liveFrame = await _player.GetCurrentFrame();
            if (liveFrame > 0 && _clipStartFrame == 0 && _clipEndFrame == 0)
            {
                _currentFrame = liveFrame;
            }
        }

        if (_clipEndFrame <= _clipStartFrame)
        {
            _clipStartFrame = Math.Max(0, _currentFrame - 2 * fps);
            _clipEndFrame = _currentFrame + 3 * fps;
        }

        _isVideoPlaying = true;
        if (_player != null)
        {
            await _player.PlayRange(_clipStartFrame, _clipEndFrame);
        }
        else if (_multiPlayer != null)
        {
            await _multiPlayer.SeekAll(_clipStartFrame);
            await _multiPlayer.TogglePlay();
        }
        StateHasChanged();
    }

