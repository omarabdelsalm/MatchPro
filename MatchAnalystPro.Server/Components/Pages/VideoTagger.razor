    public async ValueTask DisposeAsync()
    {
        _liveTimerCts?.Cancel();
        _liveTimer?.Dispose();
        try
        {
            await JS.InvokeVoidAsync("Shortcuts.unregister");
        }
        catch { }
        _shortcutsRef?.Dispose();
    }
}
