    private async Task ExportStarredMontage()
    {
        _isExportingMontage = true;
        _exportedClipUrl = "";
        _clipErrorMessage = "";
        StateHasChanged();

        try
        {
            var starredIds = _events.Where(e => e.FlaggedForReview).OrderBy(e => e.FrameNumber).Select(e => e.Id).ToList();
            string path;

            if (starredIds.Count > 0)
            {
                path = await ClipService.GenerateMultiEventClipAsync(starredIds, 4);
                _exportedClipMessage = $"تم دمج فيلم المحاضرة ({starredIds.Count} لقطات مميزة ⭐) بنجاح!";
            }
            else if (_clipEndFrame > _clipStartFrame)
            {
                path = await ClipService.GenerateRangeClipAsync(MatchId, _clipStartFrame, _clipEndFrame);
                _exportedClipMessage = $"تم قص وتصدير المقطع المحدد ({_clipStartFrame} إلى {_clipEndFrame}) بنجاح!";
            }
            else if (_events.Count > 0)
            {
                var allIds = _events.OrderBy(e => e.FrameNumber).Take(15).Select(e => e.Id).ToList();
                path = await ClipService.GenerateMultiEventClipAsync(allIds, 4);
                _exportedClipMessage = $"تم دمج فيلم لأحداث المباراة ({allIds.Count} لقطة) بنجاح!";
            }
            else
            {
                var fps = Match?.VideoFps ?? 25;
                var startF = Math.Max(0, _currentFrame - 2 * fps);
                var endF = _currentFrame + 3 * fps;
                path = await ClipService.GenerateRangeClipAsync(MatchId, startF, endF);
                _exportedClipMessage = "تم قص وتصدير لقطة مدتها 5 ثوانٍ حول الإطار الحالي بنجاح!";
            }

            _exportedClipUrl = $"/clips/{Path.GetFileName(path)}";
        }
        catch (Exception ex)
        {
            _clipErrorMessage = $"تعذر تصدير ملف الفيديو عبر FFmpeg: {ex.Message}";
        }
        finally
        {
            _isExportingMontage = false;
            StateHasChanged();
        }
    }

    private async Task SaveEvent()
    {
        if (string.IsNullOrEmpty(_selectedCategory)) return;
        if (_selectedTeamId == 0) return;

        if (_editingEvent == null && _player != null && !_liveTimerRunning)
        {
            try
            {
                var liveFrame = await _player.GetCurrentFrame();
                if (liveFrame > 0)
                {
                    _currentFrame = liveFrame;
                    _currentTimeMs = (long)(_currentFrame * 1000.0 / (Match?.VideoFps ?? 25));
                }
            }
            catch { }
        }

        var category = EventTaxonomy.GetCategory(_selectedCategory);
        var subtype = category?.SubTypes.FirstOrDefault(s => s.Key == _selectedSubType);

        // Capture Freeze Frame
        string? freezePath = _editingEvent?.FreezeFramePath;
        if ((subtype?.RequiresFreezeFrame == true || _flagForPresentation) && string.IsNullOrEmpty(freezePath))
        {
            string? base64 = null;
            if (_multiPlayer != null)
                base64 = await _multiPlayer.CaptureFrom(0, _currentFrame);
            else if (_player != null)
                base64 = await _player.CaptureFrameBase64(_currentFrame);

            if (!string.IsNullOrEmpty(base64))
            {
                var dir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "MatchAnalystPro", "freezes");
                Directory.CreateDirectory(dir);
                freezePath = Path.Combine(dir, $"ev_{Guid.NewGuid():N}.jpg");
                await File.WriteAllBytesAsync(freezePath, Convert.FromBase64String(base64));
            }
        }

        if (_editingEvent != null)
        {
            _editingEvent.TeamId = _selectedTeamId;
            _editingEvent.PlayerId = _selectedPlayerId > 0 ? _selectedPlayerId : null;
            _editingEvent.RelatedPlayerId = _relatedPlayerId > 0 ? _relatedPlayerId : null;
            _editingEvent.Period = _period;
            _editingEvent.Category = _selectedCategory;
            _editingEvent.SubType = _selectedSubType;
            _editingEvent.Outcome = _outcome;
            _editingEvent.Note = _note;
            _editingEvent.FlaggedForReview = _flagForPresentation;
            _editingEvent.X = _currentX;
            _editingEvent.Y = _currentY;
            _editingEvent.EndX = _currentEndX;
            _editingEvent.EndY = _currentEndY;
            if (_clipStartFrame > 0) _editingEvent.ClipStartFrame = _clipStartFrame;
            if (_clipEndFrame > _clipStartFrame) _editingEvent.ClipEndFrame = _clipEndFrame;
            _editingEvent.QualifiersJson = Newtonsoft.Json.JsonConvert.SerializeObject(_selectedQualifiers);
            _editingEvent.FreezeFramePath = freezePath;
            _editingEvent.LastEditedAt = DateTime.UtcNow;

            Db.Events.Update(_editingEvent);
            await Db.SaveChangesAsync();
            await Db.Entry(_editingEvent).Reference(e => e.Player).LoadAsync();
            await Db.Entry(_editingEvent).Reference(e => e.Team).LoadAsync();
            _editingEvent = null;
        }
        else
        {
            var ev = new Event
            {
                MatchId = MatchId,
                TeamId = _selectedTeamId,
                PlayerId = _selectedPlayerId > 0 ? _selectedPlayerId : null,
                RelatedPlayerId = _relatedPlayerId > 0 ? _relatedPlayerId : null,
                Period = _period,
                FrameNumber = _currentFrame,
                TimestampMs = _currentTimeMs,
                Minute = (int)(_currentTimeMs / 60000),
                Second = (int)((_currentTimeMs % 60000) / 1000),
                Category = _selectedCategory,
                SubType = _selectedSubType,
                Outcome = _outcome,
                Note = _note,
                FlaggedForReview = _flagForPresentation,
                X = _currentX,
                Y = _currentY,
                EndX = _currentEndX,
                EndY = _currentEndY,
                QualifiersJson = Newtonsoft.Json.JsonConvert.SerializeObject(_selectedQualifiers),
                FreezeFramePath = freezePath,
                ClipStartFrame = _clipStartFrame > 0 ? _clipStartFrame : Math.Max(0, _currentFrame - 75),
                ClipEndFrame = _clipEndFrame > _clipStartFrame ? _clipEndFrame : _currentFrame + 75,
            };

            Db.Events.Add(ev);
            await Db.SaveChangesAsync();

            await Db.Entry(ev).Reference(e => e.Player).LoadAsync();
            await Db.Entry(ev).Reference(e => e.Team).LoadAsync();

            _events.Insert(0, ev);

            if (_selectedCategory == "pass" && _outcome == "successful" && _relatedPlayerId > 0)
            {
                _selectedPlayerId = _relatedPlayerId;
                _relatedPlayerId = 0;
                if (_currentEndX.HasValue && _currentEndY.HasValue)
                {
                    _currentX = _currentEndX;
                    _currentY = _currentEndY;
                }
            }
        }

        try
        {
            await PossessionService.BuildPossessionsAsync(MatchId);
        }
        catch { }

        _note = "";
        _flagForPresentation = false;
        _outcome = "successful";
        _selectedQualifiers.Clear();
        _clipStartFrame = 0;
        _clipEndFrame = 0;

        if (_player != null)
        {
            await _player.SetVideoMarker(null, null, null, null, "", "");
        }

        StateHasChanged();
    }

