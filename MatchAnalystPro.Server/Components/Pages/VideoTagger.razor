    private void ToggleLiveTimer()
    {
        if (_liveTimerRunning)
        {
            _liveTimerRunning = false;
            _liveTimerCts?.Cancel();
            _liveTimer?.Dispose();
            return;
        }

        _liveTimerRunning = true;
        _liveTimerCts = new CancellationTokenSource();
        _liveTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        var fps = Match?.VideoFps ?? 25;

        _ = Task.Run(async () =>
        {
            try
            {
                while (await _liveTimer.WaitForNextTickAsync(_liveTimerCts.Token))
                {
                    _currentFrame += fps;
                    _currentTimeMs = (long)(_currentFrame * 1000.0 / fps);
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch { }
        });
    }

