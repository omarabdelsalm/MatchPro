@inherits LayoutComponentBase

<div class="page">
    <NavMenu />
    <main>
        <ErrorBoundary>
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="content-wrapper" style="text-align:center; padding:40px;">
                    <div style="font-size:36px; margin-bottom:10px;">⚠️</div>
                    <h3 style="color:#f85149; margin:0 0 8px 0;">حدث خطأ أثناء تحميل هذه الصفحة</h3>
                    <p style="color:var(--text-muted); font-size:13px; max-width:600px; margin:0 auto 16px auto;">@ex.Message</p>
                    <a href="/" class="primary" style="display:inline-block; padding:8px 16px; border-radius:6px; text-decoration:none;">
                        🏠 العودة للرئيسية
                    </a>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>
